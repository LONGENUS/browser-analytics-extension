{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PageAnalysisResult",
  "description": "Shared contract for page analysis response returned by the backend and consumed by the Chrome extension",
  "type": "object",
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string" },
    "site_type": { "type": "string", "enum": ["amazon", "flipkart", "generic"] },
    "metrics": {
      "type": "object",
      "properties": {
        "total_products": { "type": "integer" },
        "unique_asins": { "type": "integer" },
        "avg_price": { "type": "number" },
        "total_brands": { "type": "integer" }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "price": { "type": ["number", "string", "null"] },
          "asin": { "type": ["string", "null"] },
          "brand": { "type": ["string", "null"] },
          "rating": { "type": ["number", "string", "null"] },
          "reviews_count": { "type": ["integer", "string", "null"] },
          "link": { "type": "string" },
          "image": { "type": ["string", "null"] }
        },
        "required": ["title", "link"]
      }
    },
    "summary": { "type": "string" }
  },
  "required": ["url", "title", "site_type", "metrics", "products"]
}
