# Env template — copy to .env and fill in values
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://webintel:webintel@localhost:5432/webintel

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Crawl4AI
CRAWL_HEADLESS=true
CRAWL_MAX_CONCURRENT=3
CRAWL_TIMEOUT_SECONDS=30

# AI Summary (optional — leave empty to use template-based summaries)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rate Limiting
FREE_ANALYSES_PER_DAY=50
