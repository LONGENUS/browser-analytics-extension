# Backend environment template — copy to .env and fill in values
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://localhost:8000

# Database
# Local SQLite default: sqlite+aiosqlite:///webintel.db
# Supabase PostgreSQL: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///webintel.db

# Supabase Credentials (optional for local SQLite, required for Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (optional — leave empty to disable)
REDIS_URL=
CACHE_TTL_SECONDS=3600

# Crawl4AI
CRAWL_HEADLESS=true
CRAWL_MAX_CONCURRENT=3
CRAWL_TIMEOUT_SECONDS=30

# AI Summary (optional — leave empty to use template-based summaries)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rate Limiting
FREE_ANALYSES_PER_DAY=50

# Groq AI Provider Configuration (Server-side only)
# API key management: https://console.groq.com/keys
# Model catalogue: https://console.groq.com/docs/models
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq
