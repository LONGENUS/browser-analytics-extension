# WebIntel / Browser Analytics Extension — Environment Variables Template
# Copy this file to .env and configure for local or production use.

# ==============================================================================
# 1. API & Server Configuration
# ==============================================================================
DEBUG=false
APP_NAME=WebIntel
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# Base URL for API calls (used by clients, Vercel deployments, etc.)
# Development: http://localhost:8000
# Production: https://your-project.vercel.app
API_BASE_URL=https://your-project.vercel.app

# ==============================================================================
# 2. Supabase / PostgreSQL Database Configuration
# ==============================================================================
# Local SQLite fallback: sqlite+aiosqlite:///backend/webintel.db
# Supabase Transaction Pooler (port 6543) or Direct Connection (port 5432):
# postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Project Credentials (Dashboard -> Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ==============================================================================
# 3. Cache & Redis (Optional)
# ==============================================================================
# Leave empty for in-memory or disabled cache
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ==============================================================================
# 4. Crawler & Scraping Settings
# ==============================================================================
CRAWL_HEADLESS=true
CRAWL_MAX_CONCURRENT=3
CRAWL_TIMEOUT_SECONDS=30

# ==============================================================================
# 5. Optional AI Summary Service
# ==============================================================================
# Leave empty to use rule-based template summaries
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# 6. Usage Quotas & Rate Limits
# ==============================================================================
FREE_ANALYSES_PER_DAY=50
