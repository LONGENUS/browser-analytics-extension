# TailorResume Platform — Environment Variables Template
# Copy this file to .env and configure for local or production use.

# ==============================================================================
# 1. API & Server Configuration
# ==============================================================================
DEBUG=false
APP_NAME=TailorResume
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=8000

# Base URL for API calls (used by clients, Vercel deployments, etc.)
# Development: http://localhost:8000
# Production: https://your-project.vercel.app
API_BASE_URL=https://your-project.vercel.app

# ==============================================================================
# 2. Supabase / PostgreSQL Database Configuration
# ==============================================================================
# Local SQLite fallback: sqlite+aiosqlite:///backend/tailorresume.db
# Supabase Transaction Pooler (port 6543) or Direct Connection (port 5432):
# postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Project Credentials (Dashboard -> Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ==============================================================================
# 3. Resume Storage Configuration (Module 3)
# ==============================================================================
SUPABASE_RESUME_BUCKET=resumes

# ==============================================================================
# 4. Groq AI Provider Configuration (Server-side only)
# ==============================================================================
# API key management: https://console.groq.com/keys
# Model catalogue: https://console.groq.com/docs/models
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq
